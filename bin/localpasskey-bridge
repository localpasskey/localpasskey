#!/usr/bin/python3
import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
for _path in (os.path.join(_here, os.pardir), "/usr/share/localpasskey"):
    if os.path.isfile(os.path.join(_path, "localpasskey", "__init__.py")):
        sys.path.insert(0, os.path.abspath(_path))
        break

from localpasskey.bridge import main  # noqa: E402

sys.exit(main())
