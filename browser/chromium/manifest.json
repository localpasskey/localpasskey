{
  "manifest_version": 3,
  "name": "LocalPasskey",
  "version": "0.3.1",
  "description": "Lets Chrome and Chromium use LocalPasskey as this device's passkey authenticator.",
  "permissions": [
    "webAuthenticationProxy",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "key": ""
}
